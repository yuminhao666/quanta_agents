# Quanta Agents local configuration.
# Copy to .env and fill real values locally. Do not commit .env.

GJ_QUANTA_DATA_ROOT=/Users/miniquanta/document/quanta_data
GJ_PLATFORM_API_BASE=http://127.0.0.1:8000/api/v1

# Optional Agent service API if this project exposes an HTTP service.
GJ_AGENT_API_HOST=127.0.0.1
GJ_AGENT_API_PORT=8010

# Futures and market data sources. Keep passwords and tokens local.
# GJ_FUTURES_MYSQL_HOST=127.0.0.1
# GJ_FUTURES_MYSQL_PORT=3306
# GJ_FUTURES_MYSQL_USER=your_user
# GJ_FUTURES_MYSQL_PASSWORD=your_password
# GJ_FUTURES_MYSQL_DATABASE=your_database
# GJ_FUTURES_MYSQL_CHARSET=utf8mb4

# Model providers. Keep keys local or in deployment secret manager.
# OPENAI_API_KEY=sk-xxx
# DEEPSEEK_API_KEY=sk-xxx
# QUANTA_AGENT_LLM_PROVIDER=deepseek
# QUANTA_AGENT_LLM_MODEL=deepseek-chat

# Git sync policy for quanta_data, if this server writes directly.
GJ_GIT_SYNC_ENABLED=0
GJ_GIT_REMOTE=origin
GJ_GIT_BRANCH=
