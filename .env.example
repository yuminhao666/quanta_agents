# Quanta Agents local configuration.
# Copy to .env and fill real values locally. Do not commit .env.

GJ_QUANTA_DATA_ROOT=/Volumes/数字大脑/quanta_data
GJ_PLATFORM_API_BASE=http://127.0.0.1:8000/api/v1

# Optional Agent service API if this project exposes an HTTP service.
GJ_AGENT_API_HOST=127.0.0.1
GJ_AGENT_API_PORT=8010

# Futures and market data sources. Keep passwords and tokens local.
# GJ_FUTURES_MYSQL_HOST=127.0.0.1
# GJ_FUTURES_MYSQL_PORT=3306
# GJ_FUTURES_MYSQL_USER=your_user
# GJ_FUTURES_MYSQL_PASSWORD=your_password
# GJ_FUTURES_MYSQL_DATABASE=your_database
# GJ_FUTURES_MYSQL_CHARSET=utf8mb4

# Opinion radar source. Falls back to MYSQL_* or GJ_FUTURES_MYSQL_* if omitted.
# RADAR_MYSQL_HOST=127.0.0.1
# RADAR_MYSQL_PORT=3306
# RADAR_MYSQL_USER=your_user
# RADAR_MYSQL_PASSWORD=your_password
# RADAR_MYSQL_DATABASE=quant_data
RADAR_FLASH_TABLE=jin10_flash
# RADAR_LLM_PROVIDER defaults to QUANTA_AGENT_LLM_PROVIDER; set only for radar-specific routing.
# RADAR_LLM_PROVIDER=deepseek
# RADAR_LLM_PROVIDER=m3
RADAR_LLM_ENABLED=1

# Optional commodity report OSS sync.
# OSS_ACCESS_KEY_ID=your_access_key_id
# OSS_ACCESS_KEY_SECRET=your_access_key_secret
# OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
# OSS_BUCKET=nblab

# Optional override for the standard asset taxonomy file.
# GJ_ASSET_TAXONOMY_PATH=/Volumes/数字大脑/quanta_data/gold/reference_data/assets/futures_assets.v1.json

# Model providers. Keep keys local or in deployment secret manager.
# OPENAI_API_KEY=sk-xxx
# DEEPSEEK_API_KEY=sk-xxx
# DEEPSEEK_API_KEYS=sk-xxx,sk-yyy
# MINIMAX_API_KEY=sk-xxx
# MINIMAX_API_KEYS=sk-xxx,sk-yyy
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# MINIMAX_MODEL=MiniMax-M3
# MINIMAX_THINKING=disabled
# QUANTA_AGENT_LLM_PROVIDER=deepseek
# QUANTA_AGENT_LLM_PROVIDER=m3
# QUANTA_AGENT_LLM_MODEL=MiniMax-M3

# Optional framework optimizer reviewer. Uses MiniMax-M3 via the m3 provider alias.
# QUANTA_FRAMEWORK_OPTIMIZER_PROVIDER=m3
# QUANTA_FRAMEWORK_OPTIMIZER_MODEL=MiniMax-M3

# Git sync policy for quanta_data, if this server writes directly.
GJ_GIT_SYNC_ENABLED=0
GJ_GIT_REMOTE=origin
GJ_GIT_BRANCH=
